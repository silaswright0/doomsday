@PARANOIA_PARANOIAMETER_MAIN_X = 190
@PARANOIA_PARANOIAMETER_MAIN_Y = 70
@PARANOIA_PARANOIAMETER_BG_X = 144
@PARANOIA_PARANOIAMETER_BG_Y = -3
@PARANOIA_TEXT_X = 50
@PARANOIA_TEXT_Y = 180

guiTypes = {

	containerWindowType = {
		name = "dd_chi_paranoia_window"
		position = { x = 0 y = 0 }
		size = { width = 100% height = 480 }
		clipping = no

		iconType = {
			name = "paranoia_main_bg"
			spriteType = "GFX_SOV_paranoia_bg"
			position = { x = @PARANOIA_PARANOIAMETER_BG_X y = @PARANOIA_PARANOIAMETER_BG_Y }
		}

		iconType = {
			name = "paranoia_main_paranoiameter"
			spriteType = "GFX_SOV_paranoia_meter"
			position = { x = @PARANOIA_PARANOIAMETER_MAIN_X y = @PARANOIA_PARANOIAMETER_MAIN_Y }
		}

		iconType = {
			name = "paranoia_main_needle"
			spriteType = "GFX_SOV_paranoia_needle"
			position = { x = @PARANOIA_PARANOIAMETER_MAIN_X y = @PARANOIA_PARANOIAMETER_MAIN_Y }
		}

		instantTextBoxType = {
			name = "paranoia_text"
			position = { x = @PARANOIA_TEXT_X y = @PARANOIA_TEXT_Y }
			font = "hoi_18mbs"
			text = "dd_chi_paranoia_value_text"
			format = center
			maxWidth = 400
			pdx_tooltip = dd_chi_paranoia_text_tt
		}

		instantTextBoxType = {
			name = "paranoia_tooltip"
			position = { x = @PARANOIA_PARANOIAMETER_BG_X y = @PARANOIA_PARANOIAMETER_BG_Y }
			maxWidth = 230
			maxHeight = 185
			pdx_tooltip = dd_chi_paranoia_text_tt
		}

		containerWindowType = {
			name = "dd_chi_confidence_block"
			position = { x = 0 y = 268 }
			size = { width = 500 height = 200 }

			instantTextBoxType = {
				name = "dd_chi_confidence_text"
				position = { x = 50 y = 0 }
				font = "hoi_18mbs"
				text = "dd_chi_confidence_value_text"
				format = center
				maxWidth = 400
				pdx_tooltip = dd_chi_confidence_hover_tt
			}

			iconType = {
				name = "dd_chi_confidence_track"
				spriteType = "GFX_dd_chi_confidence_track"
				position = { x = 50 y = 26 }
			}

			iconType = {
				name = "dd_chi_confidence_bar"
				spriteType = "GFX_dd_chi_confidence_bar"
				position = { x = 54 y = 30 }
				frame = 20
			}

			instantTextBoxType = {
				name = "dd_chi_confidence_bar_tooltip"
				position = { x = 50 y = 22 }
				maxWidth = 400
				maxHeight = 28
				pdx_tooltip = dd_chi_confidence_hover_tt
			}

			instantTextBoxType = {
				name = "dd_chi_confidence_warning"
				position = { x = 40 y = 56 }
				font = "hoi_16mbs"
				text = "dd_chi_confidence_warning"
				format = left
				maxWidth = 420
				maxHeight = 130
				pdx_tooltip = dd_chi_confidence_hover_tt
			}
		}
	}
}
