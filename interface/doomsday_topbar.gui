guiTypes = {

	# Vanilla keeps resources on UPPER_LEFT and pins the date, speed controls,
	# and world tension to UPPER_RIGHT. The time cluster's left edge is 378px
	# in from the right. This strip uses that same edge, so cash, income, and
	# debt stay just left of the clock as the window width changes.
	# Width 230; right edge is 12px clear of the clock.
	containerWindowType = {
		name = "dd_topbar_econ_window"
		position = { x = -620 y = 4 }
		size = { width = 230 height = 30 }
		Orientation = upper_right
		clipping = no

		background = {
			name = "Background"
			quadTextureSprite = "GFX_tiled_generic_bg_1"
		}

		iconType = {
			name = "dd_cash_icon"
			spriteType = "GFX_dd_icon_cash"
			position = { x = 4 y = 3 }
			pdx_tooltip = "DD_TOPBAR_ECON_TT"
		}
