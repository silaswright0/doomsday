# Drop-in political / commander portraits.
# Add gfx/leaders/TAG/Portrait_TAG_leader.dds then point a spriteType here
# and set picture = GFX_portrait_TAG_leader in history. Missing files stay
# on GFX_portrait_unknown (vanilla).

spriteTypes = {
	spriteType = {
		name = "GFX_portrait_john_staff"
		texturefile = "gfx/leaders/doomsday/portrait_john_staff.dds"
	}
}
